# MarketGrid Environment Variables Template

# Global & Eureka Settings
EUREKA_SERVER_URL=http://localhost:8761/eureka
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017

# Security & JWT Token
JWT_SECRET=marketgrid_super_secret_jwt_key_that_is_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Transactional Mailer (Spring Mail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@marketgrid.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM_NAME=MarketGrid Platform
MAIL_FROM_ADDRESS=noreply@marketgrid.com
